<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>{{t 'title'}}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            color: #333;
        }
        .container {
            max-width: 600px;
            margin: 0 auto;
            padding: 20px;
        }
        .stats {
            background-color: #f8f9fa;
            padding: 15px;
            border-radius: 4px;
            margin: 15px 0;
            font-family: monospace;
        }
        .actions {
            background-color: #e7f3ff;
            padding: 15px;
            border-radius: 4px;
            margin: 15px 0;
        }
        .actions pre {
            background-color: #f8f9fa;
            padding: 10px;
            border-radius: 4px;
        }
        .footer {
            margin-top: 30px;
            font-size: 12px;
            color: #777;
            border-top: 1px solid #ddd;
            padding-top: 15px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>⚠️ {{t 'title'}}</h1>

        <p>{{t 'greeting'}}</p>

        <div class="stats">
            <p><strong>{{t 'current_usage' usagePercent=usagePercent usedSpace=usedSpace totalSpace=totalSpace}}</strong></p>
            <p>{{t 'threshold' threshold=threshold}}</p>
        </div>

        <p>{{t 'disk_scope'}}</p>

        <div class="actions">
            <p>{{t 'first_step'}}</p>
            <pre><code>docker system df
df -h</code></pre>
            <p><a href="{{guideUrl}}">{{t 'guide_link_text'}}</a></p>
            <p>{{t 'action_expand_storage'}}</p>
        </div>

        <p><em>{{t 'footer_note' threshold=threshold}}</em></p>

        <p>{{t 'signature'}}</p>

        <div class="footer">
            <p>{{t 'footer_text'}}</p>
        </div>
    </div>
</body>
</html>
