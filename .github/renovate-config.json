{
  "platform": "github",
  "onboarding": false,
  "requireConfig": "optional",
  "repositories": [
    "stephenhoward/pavillion",
    "stephenhoward/pavillion-site"
  ],
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "major": {
    "dependencyDashboardApproval": true
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "description": [
      "Regenerates package-lock.json weekly so in-range transitive fixes arrive without a manual bead.",
      "The window is 'on sunday' because the only Renovate run is Sunday 18:00 UTC; a schedule is a window for creating branches, not a trigger.",
      "Not automerged: the automerge rule matches minor, patch, pin and digest only, so these PRs are reviewed by hand."
    ],
    "enabled": true,
    "schedule": ["on sunday"]
  },
  "vulnerabilityAlerts": {
    "description": [
      "Security fast path: PRs open immediately, skip the minimumReleaseAge wait, ignore concurrency limits, and carry the security label."
    ],
    "prCreation": "immediate",
    "minimumReleaseAge": null,
    "prConcurrentLimit": 0,
    "branchConcurrentLimit": 0,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github actions"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Automerge minor/patch/pin/digest past 1.0 once required checks pass",
      "matchRepositories": ["stephenhoward/pavillion", "stephenhoward/pavillion-site"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "description": "Payments, auth and federation stay reviewed",
      "matchPackageNames": [
        "stripe",
        "@stripe/**",
        "@paypal/**",
        "passport**",
        "jsonwebtoken",
        "http-signature"
      ],
      "automerge": false
    }
  ]
}
