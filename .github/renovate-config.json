{
  "platform": "github",
  "onboarding": false,
  "requireConfig": "optional",
  "repositories": [
    "stephenhoward/pavillion",
    "stephenhoward/pavillion-site"
  ],
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "prHourlyLimit": 0,
  "major": {
    "dependencyDashboardApproval": true
  },
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "prCreation": "immediate",
    "minimumReleaseAge": null,
    "prConcurrentLimit": 0,
    "branchConcurrentLimit": 0,
    "labels": ["security"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github actions"
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "minimumReleaseAge": "7 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "Automerge minor/patch/pin/digest past 1.0 once required checks pass",
      "matchRepositories": ["stephenhoward/pavillion"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "matchCurrentVersion": "!/^v?0\\./",
      "automerge": true
    },
    {
      "description": "Payments, auth and federation stay reviewed",
      "matchPackageNames": [
        "stripe",
        "@stripe/**",
        "@paypal/**",
        "passport**",
        "jsonwebtoken",
        "http-signature"
      ],
      "automerge": false
    }
  ]
}
